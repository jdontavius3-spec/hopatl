# Create a free Upstash Redis database, then set these in Vercel's Environment Variables.
# Never commit the real URL or token.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-secret-token
# Set a unique, randomly generated string of at least 32 characters. Keep it private.
DRIVER_ACCESS_CODE=replace-with-a-strong-private-code
