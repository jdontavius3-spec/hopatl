{
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:group/:action", "destination": "/api/nested?__path=/api/:group/:action" },
    { "source": "/driver", "destination": "/driver/index.html" },
    { "source": "/dispatch", "destination": "/dispatch/index.html" },
    { "source": "/legal", "destination": "/legal/index.html" },
    { "source": "/((?!api|css|js|icons|audio|manifest.json|driver|dispatch|legal|pilot|favicon.ico).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
